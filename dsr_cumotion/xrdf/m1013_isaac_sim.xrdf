format: xrdf
format_version: 1.0

modifiers:
  - set_base_frame: "base_link"
  - add_frame:
      frame_name: "attached_object"
      parent_frame_name: "grasp_frame"
      joint_name: "attach_joint"
      joint_type: FIXED
      fixed_transform: 
        position: [0.0, 0.0, 0.0]
        orientation: {w: 1.0, xyz: [0.0, 0.0, 0.0]}

kinematics:
  base_link: base_link
  ee_link: grasp_frame
  lock_joints: {}

default_joint_positions:
  joint_1: 0.0
  joint_2: 0.0
  joint_3: 0.0
  joint_4: 0.0
  joint_5: 0.0
  joint_6: 0.0

tool_frames: ["grasp_frame"] # cumotion_planner_node.yaml의 tool_frames과 동일하게 설정

cspace:
  joint_names: ["joint_1", "joint_2", "joint_3", "joint_4", "joint_5", "joint_6"]
  acceleration_limits: [15.0, 15.0, 15.0, 15.0, 15.0, 15.0]
  jerk_limits: [500.0, 500.0, 500.0, 500.0, 500.0, 500.0]

collision:
  geometry: "m1013_collision_spheres"
  buffer_distance:
    link_1: 0.01
    link_2: 0.01
    link_3: 0.01
    link_4: 0.01
    link_5: 0.01
    link_6: 0.01
    tool0: 0.01
    vision_bracket: 0.01
    d435i_camera: 0.01
    robotiq_85_base_link: 0.005
    robotiq_85_left_finger_link: 0.005
    robotiq_85_left_finger_tip_link: 0.005
    robotiq_85_left_inner_knuckle_link: 0.005
    robotiq_85_left_knuckle_link: 0.005
    robotiq_85_right_finger_link: 0.005
    robotiq_85_right_finger_tip_link: 0.005 
    robotiq_85_right_inner_knuckle_link: 0.005
    robotiq_85_right_knuckle_link: 0.005
    attached_object: 0.005

self_collision:
  geometry: "m1013_collision_spheres"
  buffer_distance:
    link_1: 0.07
  ignore:
    base_link:     
      - "link_1"
    link_1:
      - "link_2"
    link_2:
      - "link_3"
    link_3:
      - "link_4"
    link_4:
      - "link_5"
    link_5:
      - "link_6"
    link_6:
      - "tool0"
      - "robotiq_85_base_link"
      - "gripper_frame"
      - "vision_bracket"
      - "d435i_camera"

    tool0: ['vision_bracket', 'd435i_camera',  'robotiq_85_base_link', 'robotiq_85_left_finger_link', 'robotiq_85_left_finger_tip_link',
    'robotiq_85_left_inner_knuckle_link', 'robotiq_85_left_knuckle_link',
    'robotiq_85_right_finger_link', 'robotiq_85_right_finger_tip_link',
    'robotiq_85_right_inner_knuckle_link', 'robotiq_85_right_knuckle_link', 'gripper_frame', 'grasp_frame']

    vision_bracket: ['d435i_camera', 'robotiq_85_base_link', 'robotiq_85_left_finger_link', 'robotiq_85_left_finger_tip_link',
    'robotiq_85_left_inner_knuckle_link', 'robotiq_85_left_knuckle_link',
    'robotiq_85_right_finger_link', 'robotiq_85_right_finger_tip_link',
    'robotiq_85_right_inner_knuckle_link', 'robotiq_85_right_knuckle_link', 'gripper_frame', 'grasp_frame']

    robotiq_85_base_link: ['tool0', 'vision_bracket', 'd435i_camera', 'robotiq_85_left_finger_link', 'robotiq_85_left_finger_tip_link',
    'robotiq_85_left_inner_knuckle_link', 'robotiq_85_left_knuckle_link',
    'robotiq_85_right_finger_link', 'robotiq_85_right_finger_tip_link',
    'robotiq_85_right_inner_knuckle_link', 'robotiq_85_right_knuckle_link', 'gripper_frame', 'grasp_frame']

    robotiq_85_left_finger_link: ['tool0', 'vision_bracket', 'd435i_camera', 'robotiq_85_left_finger_tip_link',
    'robotiq_85_left_inner_knuckle_link', 'robotiq_85_left_knuckle_link',
    'robotiq_85_right_finger_link', 'robotiq_85_right_finger_tip_link',
    'robotiq_85_right_inner_knuckle_link', 'robotiq_85_right_knuckle_link', 'gripper_frame', 'grasp_frame', "robotiq_85_base_link"]

    robotiq_85_left_finger_tip_link: ['tool0', 'vision_bracket', 'd435i_camera', 'robotiq_85_left_inner_knuckle_link', 'robotiq_85_left_knuckle_link',
    'robotiq_85_right_finger_link', 'robotiq_85_right_finger_tip_link',
    'robotiq_85_right_inner_knuckle_link', 'robotiq_85_right_knuckle_link', "robotiq_85_right_inner_knuckle_link" , 'gripper_frame', 'grasp_frame']

    robotiq_85_left_inner_knuckle_link: ['tool0', 'vision_bracket', 'd435i_camera', 'robotiq_85_left_knuckle_link',
    'robotiq_85_right_finger_link', 'robotiq_85_right_finger_tip_link',
    'robotiq_85_right_inner_knuckle_link', 'robotiq_85_right_knuckle_link', "robotiq_85_left_finger_tip_link" , 'gripper_frame', 'grasp_frame']

    robotiq_85_left_knuckle_link: ['tool0', 'vision_bracket', 'd435i_camera', 'robotiq_85_right_finger_link', 'robotiq_85_right_finger_tip_link',
    'robotiq_85_right_inner_knuckle_link', 'robotiq_85_right_knuckle_link' , 'gripper_frame', 'grasp_frame']

    robotiq_85_right_finger_link: ['tool0', 'vision_bracket', 'd435i_camera', 'robotiq_85_right_finger_tip_link',
    'robotiq_85_right_inner_knuckle_link', 'robotiq_85_right_knuckle_link' , 'gripper_frame', 'grasp_frame', "robotiq_85_base_link"]

    robotiq_85_right_finger_tip_link: ['tool0', 'vision_bracket', 'd435i_camera', 'robotiq_85_right_inner_knuckle_link', 
    'robotiq_85_right_knuckle_link', 'robotiq_85_left_inner_knuckle_link' , 'gripper_frame', 'grasp_frame']

    robotiq_85_right_inner_knuckle_link: ['tool0', 'vision_bracket', 'd435i_camera', 'robotiq_85_right_knuckle_link', "robotiq_85_right_finger_tip_link" , 'gripper_frame', 'grasp_frame']

    gripper_frame: ["grasp_frame", "tool0", robotiq_85_base_link"]
    grasp_frame: ["robotiq_85_base_link"]
    attached_object: [
    'link_5', 'link_6', 'tool0', 'vision_bracket', 'gripper_frame', 'grasp_frame', 'd435i_camera', 'robotiq_85_base_link', 
    'robotiq_85_left_finger_link', 'robotiq_85_left_finger_tip_link', 'robotiq_85_left_inner_knuckle_link', 
    'robotiq_85_left_knuckle_link', 'robotiq_85_right_finger_link', 
    'robotiq_85_right_finger_tip_link', 'robotiq_85_right_inner_knuckle_link', 'robotiq_85_right_knuckle_link']

