<?xml version="1.0"?>
<robot name="m1013">

  <link name="base_link">
    <inertial>
      <mass value="3.722"/>
      <origin xyz="-1.2e-05 -6e-05 0.050723"/>
      <inertia ixx="0.011" ixy="-7.19e-06" ixz="-1.94e-06" iyy="0.011" iyz="4.9e-06" izz="0.014"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cumotion_pkg/config/meshes/m1013_collision/MF1013_0_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cumotion_pkg/config/meshes/m1013_white/MF1013_0_0.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <link name="base"/>
  <joint name="base_link-base" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.450"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>

  <joint name="joint_1" type="revolute">
