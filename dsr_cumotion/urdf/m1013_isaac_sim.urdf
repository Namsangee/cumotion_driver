    <origin rpy="0 0 0" xyz="0 0 0.1525"/>
    <axis xyz="0 0 1"/>
    <limit effort="20400" lower="-2.1" upper="2.1" velocity="1.571"/>
    <dynamics friction="0" damping="56.6667"/>
  </joint>

  <link name="link_1">
