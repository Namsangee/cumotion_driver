  <joint name="d435i_camera_joint" type="fixed">
    <origin xyz="0 0.12 0.0455" rpy="0 0 0"/>
    <parent link="vision_bracket"/>
    <child link="d435i_camera"/>
  </joint>

  <!-- base -->
  <link name="robotiq_85_base_link">
    <visual><geometry><mesh filename="package://cumotion_pkg/config/meshes/gripper/robotiq/2f85/visual/robotiq_base.dae"/></geometry></visual>
    <collision><geometry><mesh filename="package://cumotion_pkg/config/meshes/gripper/robotiq/2f85/collision/robotiq_base.stl"/></geometry></collision>
