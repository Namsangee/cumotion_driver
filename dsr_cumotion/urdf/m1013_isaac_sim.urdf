  <!-- tool0 & vision bracket / camera -->
  <link name="tool0"/>
  <joint name="joint_6_tool0" type="fixed">
    <origin rpy="0 0 1.57" xyz="0 0 0"/>
    <parent link="link_6"/>
    <child link="tool0"/>
  </joint>

  <joint name="vision_bracket_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="tool0"/>
    <child link="vision_bracket"/>
  </joint>

  <link name="vision_bracket">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.004"/>
      <geometry>
        <mesh filename="package://cumotion_pkg/config/meshes/camera_bracket/vision_bracket.dae"/>
      </geometry>
    </visual>
  </link>

  <link name="d435i_camera">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://cumotion_pkg/config/meshes/camera_bracket/d435.dae"/>
      </geometry>
