<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="robotiq_85">

    <!-- base -->
    <link name="robotiq_85_base_link">
      <visual><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/visual/robotiq_base.dae"/></geometry></visual>
      <collision><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/collision/robotiq_base.stl"/></geometry></collision>
      <inertial>
        <origin xyz="0.0 2.274e-05 0.03232288" rpy="0 0 0"/>
        <mass value="6.6320197e-01"/>
        <inertia ixx="5.1617816e-04" iyy="5.8802208e-04" izz="3.9462776e-04" ixy="2.936e-08" ixz="0.0" iyz="-3.2296e-07"/>
      </inertial>
    </link>

    <!-- knuckles -->
    <link name="robotiq_85_left_knuckle_link">
      <visual><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/visual/left_knuckle.dae"/></geometry></visual>
      <collision><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/collision/left_knuckle.stl"/></geometry></collision>
      <inertial>
        <origin xyz="0.01213197 0.0002 -0.00058647" rpy="0 0 0"/>
        <mass value="1.384773208e-02"/>
        <inertia ixx="3.5232e-07" iyy="2.31944e-06" izz="2.23136e-06" ixy="0.0" ixz="1.1744e-07" iyz="0"/>
      </inertial>
    </link>

    <link name="robotiq_85_right_knuckle_link">
      <visual><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/visual/right_knuckle.dae"/></geometry></visual>
      <collision><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/collision/right_knuckle.stl"/></geometry></collision>
      <inertial>
        <origin xyz="-0.01213197 0.0002 -0.00058647" rpy="0 0 0"/>
        <mass value="1.384773208e-02"/>
        <inertia ixx="3.5232e-07" iyy="2.31944e-06" izz="2.23136e-06" ixy="0.0" ixz="-1.1744e-07" iyz="0.0"/>
      </inertial>
    </link>

    <!-- fingers -->
    <link name="robotiq_85_left_finger_link">
      <visual><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/visual/left_finger.dae"/></geometry></visual>
      <collision><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/collision/left_finger.stl"/></geometry></collision>
      <inertial>
        <origin xyz="0.00346899 -0.00079447 0.01867121" rpy="0 0 0"/>
        <mass value="4.260376752e-02"/>
        <inertia ixx="1.385792e-05" iyy="1.183208e-05" izz="5.19672e-06" ixy="0.0" ixz="-2.17264e-06" iyz="0.0"/>
      </inertial>
    </link>

    <link name="robotiq_85_right_finger_link">
      <visual><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/visual/right_finger.dae"/></geometry></visual>
      <collision><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/collision/right_finger.stl"/></geometry></collision>
      <inertial>
        <origin xyz="-0.00346899 -5.53e-06 0.01867121" rpy="0 0 0"/>
        <mass value="4.260376752e-02"/>
        <inertia ixx="1.385792e-05" iyy="1.183208e-05" izz="5.19672e-06" ixy="0.0" ixz="2.17264e-06" iyz="0.0"/>
      </inertial>
    </link>

    <!-- inner knuckles -->
    <link name="robotiq_85_left_inner_knuckle_link">
      <visual><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/visual/left_inner_knuckle.dae"/></geometry></visual>
      <collision><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/collision/left_inner_knuckle.stl"/></geometry></collision>
      <inertial>
        <origin xyz="0.01897699 0.00015001 0.02247101" rpy="0 0 0"/>
        <mass value="2.969376448e-02"/>
        <inertia ixx="9.57136e-06" iyy="8.69056e-06" izz="8.19144e-06" ixy="0.0" ixz="-3.93424e-06" iyz="0.0"/>
      </inertial>
    </link>

    <link name="robotiq_85_right_inner_knuckle_link">
      <visual><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/visual/right_inner_knuckle.dae"/></geometry></visual>
      <collision><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/collision/right_inner_knuckle.stl"/></geometry></collision>
      <inertial>
        <origin xyz="-0.01926824 5.001e-05 0.02222178" rpy="0 0 0"/>
        <mass value="2.969376448e-02"/>
        <inertia ixx="9.42456e-06" iyy="8.69056e-06" izz="8.33824e-06" ixy="0.0" ixz="3.9636e-06" iyz="0.0"/>
      </inertial>
    </link>

    <!-- finger tips -->
    <link name="robotiq_85_left_finger_tip_link">
      <visual><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/visual/left_finger_tip.dae"/></geometry></visual>
      <collision>
        <geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/collision/left_finger_tip.stl"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.01456706 -0.0008 0.01649701" rpy="0 0 0"/>
        <mass value="4.268588744e-02"/>
        <inertia ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06" ixy="0.0" ixz="3.5232e-06" iyz="0.0"/>
      </inertial>
    </link>

    <link name="robotiq_85_right_finger_tip_link">
      <visual><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/visual/right_finger_tip.dae"/></geometry></visual>
      <collision><geometry><mesh filename="package://dsr_cumotion/meshes/gripper/robotiq/2f85/collision/right_finger_tip.stl"/></geometry></collision>
      <inertial>
        <origin xyz="0.01456706 5e-05 0.01649701" rpy="0 0 0"/>
        <mass value="4.268588744e-02"/>
        <inertia ixx="1.048152e-05" iyy="1.197888e-05" izz="4.22784e-06" ixy="0.0" ixz="-3.5232e-06" iyz="0.0"/>
      </inertial>
    </link>

    <joint name="robotiq_85_base_joint" type="fixed">
      <parent link="gripper_frame"/>
      <child  link="robotiq_85_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 1.57"/>
    </joint>

    <joint name="robotiq_85_left_knuckle_joint" type="revolute">
      <parent link="robotiq_85_base_link"/>
      <child  link="robotiq_85_left_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="0.03060114 0.0 0.05490452" rpy="0 0 0"/>
      <limit lower="0.0" upper="0.8" velocity="0.5" effort="50"/>
    </joint>

    <joint name="robotiq_85_right_knuckle_joint" type="revolute">
      <parent link="robotiq_85_base_link"/>
      <child  link="robotiq_85_right_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="-0.03060114 0.0 0.05490452" rpy="0 0 0"/>
      <limit lower="-0.8" upper="0.0" velocity="0.5" effort="50"/>
      <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1" offset="0.0"/>
    </joint>

    <joint name="robotiq_85_left_finger_joint" type="fixed">
      <parent link="robotiq_85_left_knuckle_link"/>
      <child  link="robotiq_85_left_finger_link"/>
      <origin xyz="0.03152616 0.0 -0.00376347" rpy="0 0 0"/>
    </joint>

    <joint name="robotiq_85_right_finger_joint" type="fixed">
      <parent link="robotiq_85_right_knuckle_link"/>
      <child  link="robotiq_85_right_finger_link"/>
      <origin xyz="-0.03152616 0.0 -0.00376347" rpy="0 0 0"/>
    </joint>

    <joint name="robotiq_85_left_inner_knuckle_joint" type="revolute">
      <parent link="robotiq_85_base_link"/>
      <child  link="robotiq_85_left_inner_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="0.0127 0.0 0.06142" rpy="0 0 0"/>
      <limit lower="-3.14" upper="3.14" velocity="10.0" effort="0.1"/>
      <mimic joint="robotiq_85_left_knuckle_joint" multiplier="1" offset="0.0"/>
    </joint>

    <joint name="robotiq_85_right_inner_knuckle_joint" type="revolute">
      <parent link="robotiq_85_base_link"/>
      <child  link="robotiq_85_right_inner_knuckle_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="-0.0127 0.0 0.06142" rpy="0 0 0"/>
      <limit lower="-3.14" upper="3.14" velocity="10.0" effort="0.1"/>
      <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1" offset="0.0"/>
    </joint>

    <joint name="robotiq_85_left_finger_tip_joint" type="revolute">
      <parent link="robotiq_85_left_finger_link"/>
      <child  link="robotiq_85_left_finger_tip_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="0.00563134 0.0 0.04718515" rpy="0 0 0"/>
      <limit lower="-3.14" upper="3.14" velocity="10.0" effort="0.1"/>
      <mimic joint="robotiq_85_left_knuckle_joint" multiplier="-1" offset="0.0"/>
    </joint>

    <joint name="robotiq_85_right_finger_tip_joint" type="revolute">
      <parent link="robotiq_85_right_finger_link"/>
      <child  link="robotiq_85_right_finger_tip_link"/>
      <axis xyz="0 -1 0"/>
      <origin xyz="-0.00563134 0.0 0.04718515" rpy="0 0 0"/>
      <limit lower="-3.14" upper="3.14" velocity="10.0" effort="0.1"/>
      <mimic joint="robotiq_85_left_knuckle_joint" multiplier="1" offset="0.0"/>
    </joint>

    <link name="grasp_frame">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 3.14"/>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="grasp_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.1560"/>
      <parent link="gripper_frame"/>
      <child  link="grasp_frame"/>
    </joint>
    
  </xacro:macro>
</robot>
